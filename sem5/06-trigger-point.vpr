domain Point { 

   function cons(x: Int, y: Int): Point

   function first(p: Point): Int 
   function second(p: Point): Int 

   axiom destruct_over_construct {
      forall x: Int, y: Int :: first(cons(x,y)) == x && second(cons(x,y)) == y
   }

   function add(p: Point, q: Point): Point 

   // This trigger verifies the client below. Other useful experiments:
   // { first(add(p,q)) } usually fails to trigger the second component,
   // while triggers that recreate add terms can make matching loop.
   axiom add_points { 
      forall p: Point, q: Point :: { add(p,q) }  
         first(add(p,q)) == first(p) + first(q) 
         && second(add(p,q)) == second(p) + second(q)
   }
}


method test()
{
   var x: Point := add( cons(17, 42), cons(3,8) )

   assert first(x) == 20
   assert second(x) == 50
}
